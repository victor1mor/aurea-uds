{
  "name": "@aurea-uds/fonts",
  "version": "0.52.1",
  "description": "As fontes da Aurea: Inter (texto), Sora (títulos) e IBM Plex Mono (código), em WOFF2 para a web (@aurea-uds/fonts/css). Para o React Native (@aurea-uds/fonts/native), as mesmas três em TTF estático, um arquivo por peso.",
  "keywords": [
    "aurea",
    "design-system",
    "fonts",
    "inter",
    "sora",
    "ibm-plex-mono",
    "react-native"
  ],
  "license": "OFL-1.1",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/victor1mor/aurea-uds.git",
    "directory": "packages/fonts"
  },
  "homepage": "https://github.com/victor1mor/aurea-uds/tree/main/packages/fonts#readme",
  "bugs": {
    "url": "https://github.com/victor1mor/aurea-uds/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist",
    "files",
    "files-native"
  ],
  "exports": {
    "./css": {
      "types": "./dist/fonts.css.d.ts",
      "default": "./dist/fonts.css"
    },
    "./native": {
      "types": "./dist/fonts.native.d.ts",
      "default": "./dist/fonts.native.js"
    }
  },
  "scripts": {
    "build": "node build-fonts.mjs"
  }
}
